{
  "name": "kirochat-ui-automation-tests",
  "version": "1.0.0",
  "description": "KiroChat UI Automation Tests - Jest + Selenium WebDriver + Allure Report",
  "scripts": {
    "test": "jest --forceExit --detectOpenHandles",
    "test:tc03": "jest --testPathPattern=TC03 --forceExit --detectOpenHandles",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "test:report": "npm test && npm run allure:generate && npm run allure:open"
  },
  "dependencies": {
    "selenium-webdriver": "^4.27.0",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "allure-js-commons": "^2.15.1",
    "jasmine-allure-reporter": "^1.0.3",
    "jest-allure": "^0.1.3"
  },
  "devDependencies": {
    "chromedriver": "^131.0.0"
  }
}
