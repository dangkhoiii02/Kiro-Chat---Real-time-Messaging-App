<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Remote Video -->
    <io.livekit.android.renderer.SurfaceViewRenderer
        android:id="@+id/surface_remote"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <!-- Avatar fallback when no remote video -->
    <ImageView
        android:id="@+id/iv_remote_avatar"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_centerInParent="true"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_avatar"
        android:clipToOutline="true"
        tools:src="@drawable/ic_avatar_placeholder"/>

    <!-- Local Video (PiP) -->
    <io.livekit.android.renderer.SurfaceViewRenderer
        android:id="@+id/surface_local"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/layout_controls"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        android:elevation="8dp"/>

    <!-- Top Bar (Name, Timer) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="48dp"
        android:background="#44000000">

        <TextView
            android:id="@+id/tv_caller_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="20sp"
            tools:text="Nguyen Van A"/>

        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:text="Đang kết nối..."/>
    </LinearLayout>

    <!-- Controls Bottom Bar -->
    <LinearLayout
        android:id="@+id/layout_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="48dp"
        android:paddingTop="24dp"
        android:background="#44000000">

        <!-- Toggle Speaker -->
        <ImageButton
            android:id="@+id/btn_speaker"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_icon_button"
            android:backgroundTint="#88FFFFFF"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            android:contentDescription="Loa ngoài"/>

        <!-- Toggle Camera -->
        <ImageButton
            android:id="@+id/btn_camera"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_icon_button"
            android:backgroundTint="#88FFFFFF"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Camera"/>

        <!-- Toggle Microphone -->
        <ImageButton
            android:id="@+id/btn_mic"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_icon_button"
            android:backgroundTint="#88FFFFFF"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="Mic"/>

        <!-- Hang Up -->
        <ImageButton
            android:id="@+id/btn_hangup"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_icon_button"
            android:backgroundTint="@color/delete_red"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Kết thúc"/>

    </LinearLayout>

</RelativeLayout>
